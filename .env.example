# === Telegram ===
# Token lấy từ @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_token_here

# ID Telegram của bạn (chủ bot). Lấy bằng cách nhắn cho @userinfobot
OWNER_ID=123456789

# === OpenAI ===
OPENAI_API_KEY=sk-your-openai-key-here

# Model: gpt-4.1-mini (khuyên dùng - nhanh, rẻ) hoặc gpt-4.1 (chất lượng cao nhất)
OPENAI_MODEL=gpt-4.1-mini

# === Tùy chọn ===
# File lưu danh sách user được duyệt
ALLOWED_USERS_FILE=allowed_users.json

# Giới hạn số tin nhắn dịch tối đa trong mỗi cửa sổ thời gian (chống spam/cháy tiền API)
RATE_LIMIT_MAX=20

# Độ dài cửa sổ rate limit, tính theo giây
RATE_LIMIT_WINDOW=60

# Độ dài tối đa của một tin nhắn đem đi dịch
MAX_MESSAGE_LENGTH=2000

# Cooldown tối thiểu giữa các lần /start của người lạ
START_COOLDOWN_SECONDS=30
